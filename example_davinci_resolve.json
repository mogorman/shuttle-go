{
    "apps": [
        {
            "name": "DaVinci Resolve",
            "match_wm_class": [
                "resolve"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": "space // Stop",
                "F2": "x // Insert Clip",
                "F3": "Alt+i // Clear In",
                "F4": "Alt+o // Clear Out",
                "F5": "Ctrl+z // Undo",
                "F6": "Ctrl+Shift+z // Redo",
                "F7": "i // Mark In",
                "F8": "o // Mark Out",
                "F9": "y // Overwrite Clip",
                "B1": "n // Snapping On/Off",
                "B2": "0x26 // Previous Edit ( & )",
                "B3": "j // Reverse",
                "B4": "k // Stop",
                "M1": "l // Forward",
                "M2": "0x28 // Next Edit ( ( )",
                "JogL": "0x25 // Backward One Frame ( % )",
                "JogR": "' // Forward One Frame ( ' )",

                "S-7": { "key": "0x25", "repeat": 2, "delay_ms": 1000 },
                "S-6": { "key": "0x25", "repeat": 5, "delay_ms": 1000 },
                "S-5": { "key": "0x25", "repeat": 10, "delay_ms": 1000 },
                "S-4": { "key": "0x25", "repeat": 15, "delay_ms": 1000 },
                "S-3": { "key": "0x25", "repeat": 30, "delay_ms": 1000 },
                "S-2": { "key": "0x25", "repeat": 45, "delay_ms": 1000 },
                "S-1": { "key": "0x25", "repeat": 60, "delay_ms": 1000 },
                "S0": "k // Stop",
                "S1": { "key": "'", "repeat": 2, "delay_ms": 1000 },
                "S2": { "key": "'", "repeat": 5, "delay_ms": 1000 },
                "S3": { "key": "'", "repeat": 10, "delay_ms": 1000 },
                "S4": { "key": "'", "repeat": 15, "delay_ms": 1000 },
                "S5": { "key": "'", "repeat": 30, "delay_ms": 1000 },
                "S6": { "key": "'", "repeat": 45, "delay_ms": 1000 },
                "S7": { "key": "'", "repeat": 60, "delay_ms": 1000 }
            }
        }
    ]
}
