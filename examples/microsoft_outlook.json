{
    "apps": [
        {
            "name": "Microsoft Outlook",
            "match_window_titles": [
                "Microsoft Outlook",
                "OUTLOOK"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": {
                    "key": "Ctrl+F",
                    "comment": "Forward"
                },
                "B2": {
                    "key": "Ctrl+Shift+B",
                    "comment": "Display the Address Book"
                },
                "B3": {
                    "key": "Alt+F4",
                    "comment": "Quit"
                },
                "B4": {
                    "key": "F7",
                    "comment": "Check spelling"
                },
                "M1": {
                    "key": "Ctrl+Shift+G",
                    "comment": "Flag for follow up"
                },
                "M2": {
                    "key": "Ctrl+Z",
                    "comment": "Undo/Redo"
                },
                "F2": {
                    "key": "Ctrl+Shift+R",
                    "comment": "Reply all to a mail message"
                },
                "F3": {
                    "key": "Ctrl+R",
                    "comment": "Reply to a mail message"
                },
                "F4": {
                    "key": "Ctrl+N",
                    "comment": "Open a new message"
                },
                "F5": {
                    "key": "Ctrl+Y",
                    "comment": "Go to folder / Redo"
                },
                "F6": {
                    "key": "Ctrl+X",
                    "comment": "Cut"
                },
                "F7": {
                    "key": "Ctrl+V",
                    "comment": "Paste"
                },
                "F8": {
                    "key": "Ctrl+C",
                    "comment": "Copy"
                },
                "F9": {
                    "key": "Ctrl+Shift+F",
                    "comment": "Use advanced Find"
                },
                "JogL": "Shift+!",
                "S-1": "Shift+&",
                "S-2": "Shift+&",
                "S-3": {
                    "key": "Shift+&",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S-4": {
                    "key": "Shift+&",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-5": {
                    "key": "Shift+&",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "Shift+&",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S-7": {
                    "key": "Shift+&",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S1": "Shift+(",
                "S2": "Shift+(",
                "S3": {
                    "key": "Shift+(",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S4": {
                    "key": "Shift+(",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S5": {
                    "key": "Shift+(",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S6": {
                    "key": "Shift+(",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S7": {
                    "key": "Shift+(",
                    "repeat": 30,
                    "delay_ms": 1000
                }
            }
        }
    ]
}
