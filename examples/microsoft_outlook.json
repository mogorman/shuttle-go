{
    "apps": [
        {
            "name": "Microsoft Outlook",
            "match_window_titles": [
                "Microsoft\\ Outlook",
                "OUTLOOK"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": "Ctrl+F",
                "B2": "Ctrl+Shift+B",
                "B3": "Alt+F4",
                "B4": "F7",
                "M1": "Ctrl+Shift+G",
                "M2": "Ctrl+Z",
                "F2": "Ctrl+Shift+R",
                "F3": "Ctrl+R",
                "F4": "Ctrl+N",
                "F5": "Ctrl+Y",
                "F6": "Ctrl+X",
                "F7": "Ctrl+V",
                "F8": "Ctrl+C",
                "F9": "Ctrl+Shift+F",
                "JogL": "Shift+1",
                "S-1": "Ampersand",
                "S-2": "Ampersand",
                "S-3": {
                    "key": "Ampersand",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S-4": {
                    "key": "Ampersand",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-5": {
                    "key": "Ampersand",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "Ampersand",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S-7": {
                    "key": "Ampersand",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S1": "LeftParen",
                "S2": "LeftParen",
                "S3": {
                    "key": "LeftParen",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S4": {
                    "key": "LeftParen",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S5": {
                    "key": "LeftParen",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S6": {
                    "key": "LeftParen",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S7": {
                    "key": "LeftParen",
                    "repeat": 30,
                    "delay_ms": 1000
                }
            }
        }
    ]
}
