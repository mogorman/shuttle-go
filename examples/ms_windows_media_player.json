                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "0x14",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S-7": "0x14",
                "S1": "0x16",
                "S2": {
                    "key": "0x16",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S3": {
                    "key": "0x16",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S4": {
                    "key": "0x16",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S5": {
                    "key": "0x16",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S6": {
                    "key": "0x16",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S7": "0x16"
            }
        }
    ]
