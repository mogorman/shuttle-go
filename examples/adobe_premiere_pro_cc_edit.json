                "Adobe Premiere Pro CC (Edit)",
                "Adobe Premiere Pro"
            ],
            "slow_jog": 200,
            "bindings": {
                "B1": "Ctrl+Shift+I",
                "B2": "Ctrl+Shift+O",
                "B3": "T",
                "M1": "I",
                "M2": "O",
                "F2": "Ctrl+D",
                "F5": "Shift+&",
                "F6": "J",
                "F7": "K",
                "F8": "L",
                "F9": "Shift+(",
                "JogL": "Shift+%",
                "JogR": "Shift+'",
                "S-1": {
                    "key": "Shift+%",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-2": {
                    "key": "Shift+%",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-3": {
                    "key": "Shift+%",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S-4": {
                    "key": "Shift+%",
                    "repeat": 30,
                    "delay_ms": 1000
