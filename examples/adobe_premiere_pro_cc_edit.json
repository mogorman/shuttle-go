                "S-5": {
                    "key": "Shift+%",
                    "repeat": 45,
                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "Shift+Shift+%",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S-7": {
                    "key": "Shift+Shift+%",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S1": {
                    "key": "Shift+'",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S2": {
                    "key": "Shift+'",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S3": {
                    "key": "Shift+'",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S4": {
                    "key": "Shift+'",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S5": {
                    "key": "Shift+'",
                    "repeat": 45,
                    "delay_ms": 1000
                },
                "S6": {
                    "key": "Shift+Shift+'",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S7": {
                    "key": "Shift+Shift+'",
                    "repeat": 30,
                    "delay_ms": 1000
                }
            }
