{
    "apps": [
        {
            "name": "Adobe After Effects CC",
            "match_window_titles": [
                "Adobe\\ After\\ Effects\\ CC",
                "AfterFX"
            ],
            "slow_jog": 200,
            "bindings": {
                "B1": "V",
                "B2": "H",
                "B3": "W",
                "B4": "Z",
                "F2": "Ctrl+K",
                "F3": "Ctrl+LeftParen",
                "F4": "Ctrl+Ampersand",
                "F5": "Shift+4",
                "F6": "J",
                "F7": "space",
                "F8": "K",
                "F9": "Shift+3",
                "JogL": "Ctrl+Percent",
                "JogR": "Ctrl+ShiftApostrophe",
                "S-1": {
                    "key": "Shift+1",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S-2": {
                    "key": "Shift+1",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-3": {
                    "key": "Shift+1",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-4": {
                    "key": "Shift+1",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S-5": {
                    "key": "Shift+1",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "Shift+Shift+1",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-7": {
                    "key": "Shift+Shift+1",
                    "repeat": 15,
                    "delay_ms": 1000
                }
            }
        }
    ]
