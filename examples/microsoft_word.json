{
    "apps": [
        {
            "name": "Microsoft Word",
            "match_window_titles": [
                "Microsoft Word",
                "WINWORD"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": {
                    "key": "Ctrl+Alt+I",
                    "comment": "Switch in/out of Print Preview"
                },
                "B1": {
                    "key": "Ctrl+Alt+S",
                    "comment": "Split the document window"
                },
                "B2": {
                    "key": "Ctrl+Shift+N",
                    "comment": "Apply the Normal style"
                },
                "B3": {
                    "key": "Alt+Shift+C",
                    "comment": "Remove document windows split"
                },
                "M1": {
                    "key": "Ctrl+Z",
                    "comment": "Undo"
                },
                "M2": {
                    "key": "Ctrl+S",
                    "comment": "Save"
                },
                "F2": {
                    "key": "Ctrl+Shift+E",
                    "comment": "Turn track changes on or off"
                },
                "F3": {
                    "key": "Shift+F7",
                    "comment": "Choose the Thesaurus command"
                },
                "F4": {
                    "key": "Shift+F3",
                    "comment": "Change the case of letters"
                },
                "F5": {
                    "key": "Shift+S",
                    "comment": "Repeat find"
                },
                "F6": {
                    "key": "Ctrl+F",
                    "comment": "Find text, formatting, ..."
                },
                "F7": {
                    "key": "Ctrl+X",
                    "comment": "Cut selected text or object"
                },
                "F8": {
                    "key": "Ctrl+V",
                    "comment": "Paste text or object"
                },
                "F9": {
                    "key": "Ctrl+C",
                    "comment": "Copy selected text or object"
                },
                "JogL": "Shift+%",
                "JogR": "Shift+'",
                "S-1": {
                    "key": "Shift+&",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-2": {
                    "key": "Shift+&",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-3": {
                    "key": "Shift+&",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S-4": {
                    "key": "Shift+&",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S-5": {
                    "key": "Shift+&",
                    "repeat": 45,
                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "Shift+&",
                    "repeat": 60,
                    "delay_ms": 1000
                },
                "S-7": "Shift+&",
                "S1": {
                    "key": "Shift+(",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S2": {
                    "key": "Shift+(",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S3": {
                    "key": "Shift+(",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S4": {
                    "key": "Shift+(",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S5": {
                    "key": "Shift+(",
                    "repeat": 45,
                    "delay_ms": 1000
                },
                "S6": {
                    "key": "Shift+(",
                    "repeat": 60,
                    "delay_ms": 1000
                },
                "S7": "Shift+("
            }
        }
    ]
}
