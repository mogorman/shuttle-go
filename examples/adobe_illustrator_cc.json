{
    "apps": [
        {
            "name": "Adobe Illustrator CC",
            "match_window_titles": [
                "Adobe\\ Illustrator\\ CC",
                "Illustrator"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": "Shift+8",
                "B1": "P",
                "B2": "Ctrl+Shift+E",
                "B3": "T",
                "B4": "Ctrl+Alt+Shift+E",
                "M1": "Ctrl+Shift+Z",
                "M2": "Ctrl+Z",
                "F2": "Ctrl+S",
                "F3": "Ctrl+Shift+S",
                "F4": "Ctrl+N",
                "F6": "Ctrl+X",
                "F7": "Ctrl+C",
                "F8": "Ctrl+V",
                "JogL": "Percent",
                "JogR": "ShiftApostrophe",
                "S-1": "Ampersand",
                "S-2": {
                    "key": "Ampersand",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S-3": {
                    "key": "Ampersand",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-4": {
                    "key": "Shift+Ampersand",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S-5": {
                    "key": "Shift+Ampersand",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "Shift+Ampersand",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-7": {
                    "key": "Shift+Ampersand",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S1": "LeftParen",
                "S2": {
                    "key": "LeftParen",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S3": {
                    "key": "LeftParen",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S4": {
                    "key": "Shift+LeftParen",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S5": {
                    "key": "Shift+LeftParen",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S6": {
                    "key": "Shift+LeftParen",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S7": {
                    "key": "Shift+LeftParen",
                    "repeat": 15,
                    "delay_ms": 1000
                }
            }
        }
    ]
}
