{
    "apps": [
        {
            "name": "Microsoft Excel",
            "match_window_titles": [
                "Microsoft Excel",
                "EXCEL"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": {
                    "key": "Ctrl+Z",
                    "comment": "Undo the last action"
                },
                "B1": {
                    "key": "Alt+F11",
                    "comment": "Display the Visual Basic Editor"
                },
                "B3": {
                    "key": "Alt+F8",
                    "comment": "Display the Macro dialog box"
                },
                "M1": {
                    "key": "Ctrl+P",
                    "comment": "Print"
                },
                "M2": {
                    "key": "Ctrl+S",
                    "comment": "Save"
                },
                "F2": {
                    "key": "Ctrl+R",
                    "comment": "Define a name"
                },
                "F3": {
                    "key": "Shift+F3",
                    "comment": "Paste a function into a formula"
                },
                "F4": {
                    "key": "Ctrl+1",
                    "comment": "Display the Format Cells dialog"
                },
                "F8": {
                    "key": "Shift+space",
                    "comment": "Select the entire row"
                },
                "F9": {
                    "key": "Ctrl+space",
                    "comment": "Select the entire column"
                },
                "S-1": "Shift+%",
                "S-2": "Shift+%",
                "S-3": {
                    "key": "Shift+%",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S-4": {
                    "key": "Shift+%",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-5": {
                    "key": "Shift+%",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "Shift+%",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S-7": {
                    "key": "Shift+%",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S1": "Shift+'",
                "S2": "Shift+'",
                "S3": {
                    "key": "Shift+'",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S4": {
                    "key": "Shift+'",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S5": {
                    "key": "Shift+'",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S6": {
                    "key": "Shift+'",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S7": {
                    "key": "Shift+'",
                    "repeat": 30,
                    "delay_ms": 1000
                }
            }
        }
    ]
}
