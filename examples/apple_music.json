{
    "apps": [
        {
            "name": "Apple Music",
            "match_window_titles": [
                "Apple\\ Music",
                "iTunes"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": "Ctrl+N",
                "B1": "Ctrl+T",
                "B2": "Ctrl+Shift+2",
                "B3": "Ctrl+Shift+F",
                "B4": "Ctrl+L",
                "M1": "Ctrl+J",
                "M2": "Ctrl+B",
                "F2": "Ctrl+O",
                "F5": "Ctrl+Alt+Shift+%",
                "F6": "Shift+%",
                "F7": "space",
                "F8": "Shift+'",
                "F9": "Ctrl+Alt+Shift+'",
                "JogL": "Ctrl+Shift+(",
                "JogR": "Ctrl+Shift+&",
                "S-1": "Shift+&",
                "S-4": {
                    "key": "Shift+&",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S-5": {
                    "key": "Shift+&",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "Shift+&",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-7": {
                    "key": "Shift+&",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S1": "Shift+(",
                "S4": {
                    "key": "Shift+(",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S5": {
                    "key": "Shift+(",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S6": {
                    "key": "Shift+(",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S7": {
                    "key": "Shift+(",
                    "repeat": 15,
                    "delay_ms": 1000
                }
            }
        }
    ]
}
