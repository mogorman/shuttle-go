{
    "apps": [
        {
            "name": "Apple Music",
            "match_window_titles": [
                "Apple\\ Music",
                "iTunes"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": "Ctrl+N",
                "B1": "Ctrl+T",
                "B2": "Ctrl+Shift+2",
                "B3": "Ctrl+Shift+F",
                "B4": "Ctrl+L",
                "M1": "Ctrl+J",
                "M2": "Ctrl+B",
                "F2": "Ctrl+O",
                "F5": "Ctrl+Alt+Percent",
                "F6": "Percent",
                "F7": "space",
                "F8": "ShiftApostrophe",
                "F9": "Ctrl+Alt+ShiftApostrophe",
                "JogL": "Ctrl+LeftParen",
                "JogR": "Ctrl+Ampersand",
                "S-1": "Ampersand",
                "S-4": {
                    "key": "Ampersand",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S-5": {
                    "key": "Ampersand",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "Ampersand",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-7": {
                    "key": "Ampersand",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S1": "LeftParen",
                "S4": {
                    "key": "LeftParen",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S5": {
                    "key": "LeftParen",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S6": {
                    "key": "LeftParen",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S7": {
                    "key": "LeftParen",
                    "repeat": 15,
                    "delay_ms": 1000
                }
            }
        }
    ]
}
