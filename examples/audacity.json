{
    "apps": [
        {
            "name": "Audacity",
            "match_window_titles": [
                "Audacity"
            ],
            "slow_jog": 200,
            "bindings": {
                "F1": "Ctrl+S",
                "B1": "Shift+U",
                "B2": "Ctrl+1",
                "B3": "Shift+S",
                "B4": "Ctrl+3",
                "M1": "Ctrl+Y",
                "M2": "Ctrl+Z",
                "F2": "Ctrl+X",
                "F3": "Ctrl+C",
                "F4": "Ctrl+V",
                "F5": "Shift+$",
                "F7": "space",
                "F9": "Shift+#",
                "JogL": "Shift+%",
                "JogR": "Shift+'",
                "S-1": {
                    "key": "Shift+%",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S-2": {
                    "key": "Shift+%",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S-3": {
                    "key": "Shift+%",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S-4": {
                    "key": "Shift+%",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S-5": {
                    "key": "Shift+%",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S-6": {
                    "key": "Shift+%",
                    "repeat": 45,
                    "delay_ms": 1000
                },
                "S-7": "Shift+%",
                "S1": {
                    "key": "Shift+'",
                    "repeat": 2,
                    "delay_ms": 1000
                },
                "S2": {
                    "key": "Shift+'",
                    "repeat": 5,
                    "delay_ms": 1000
                },
                "S3": {
                    "key": "Shift+'",
                    "repeat": 10,
                    "delay_ms": 1000
                },
                "S4": {
                    "key": "Shift+'",
                    "repeat": 15,
                    "delay_ms": 1000
                },
                "S5": {
                    "key": "Shift+'",
                    "repeat": 30,
                    "delay_ms": 1000
                },
                "S6": {
                    "key": "Shift+'",
                    "repeat": 45,
                    "delay_ms": 1000
                },
                "S7": "Shift+'"
            }
        }
    ]
}
